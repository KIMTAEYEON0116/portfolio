# 노션 연동 (일정 API)
NOTION_TOKEN=
NOTION_DB_ID=

# 방명록 수정/삭제 권한 토큰. 비워두면 해당 기능이 완전히 차단됩니다.
ADMIN_TOKEN=

# 사이트 주소 (예: https://example.com). 비우면 접속한 주소를 그대로 쓴다. 공유 미리보기 이미지용
SITE_URL=

# CORS 허용 출처 (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# API 문서(/docs) 공개 여부. 1일 때만 공개됩니다.
ENABLE_DOCS=0

# 서버 바인딩
HOST=127.0.0.1
PORT=8000
# 개발 중 코드 변경 시 자동 재시작 (배포 서버에서는 0)
RELOAD=0

# nginx 같은 리버스 프록시 뒤에서 실행하면 1 (방문자 IP 를 X-Real-IP 에서 읽음)
TRUST_PROXY=0
# 방명록 전체 등록 한도 (1시간 합계, 알림 메일 폭주 방지)
GUESTBOOK_MAX_PER_HOUR=30

# 방명록 알림 메일 (선택). 비워두면 기능이 꺼진 채로 정상 동작합니다.
# Gmail 은 계정 비밀번호가 아니라 "앱 비밀번호"(공백 없는 16자리)를 넣어야 합니다.
#   Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_TO=
