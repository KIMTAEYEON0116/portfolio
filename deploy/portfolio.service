# systemd 서비스 — 서버가 재부팅돼도 사이트가 자동으로 켜지게 한다
# 설치: sudo cp deploy/portfolio.service /etc/systemd/system/ && sudo systemctl enable --now portfolio
[Unit]
Description=Portfolio site (FastAPI)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/portfolio
# 설정값은 같은 폴더의 .env 에서 읽는다 (main.py 의 load_dotenv)
ExecStart=/home/ubuntu/portfolio/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
